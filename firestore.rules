rules_version = '2';

// Modelo de acesso do Shadowlords Mesa:
// - Qualquer pessoa autenticada (mesmo anonimamente) que conheça o ID da mesa
//   (o código de 5 letras compartilhado no Discord) pode LER a mesa — é assim
//   que jogadores acompanham fichas, NPCs, a cena e o log em tempo real.
// - Só o Mestre (gmUid, uma conta de e-mail/senha) escreve em NPCs, cena e
//   configurações da mesa, e só ele lê as rolagens secretas.
// - Um personagem é editado por quem o controla (ownerUid) ou pelo Mestre.
//   Um jogador pode "reivindicar" a ficha em outro dispositivo entrando com o
//   nome do personagem — essa troca só altera ownerUid.
// - O super administrador do sistema (dono da instalação) enxerga e administra
//   todas as mesas. Ele é identificado por um documento em /superAdmins, criado
//   fora do app (pelo Admin SDK) — nunca pelo cliente.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tableData(tableId) {
      return get(/databases/$(database)/documents/tables/$(tableId)).data;
    }

    function isGM(tableId) {
      return signedIn() && tableData(tableId).gmUid == request.auth.uid;
    }

    function isSuperAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    // Crachá do super administrador: cada um só consegue checar o próprio, e
    // ninguém cria ou apaga pelo app — só pelo Admin SDK.
    match /superAdmins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Índice particular de cada Mestre: lista das mesas que ele criou, para
    // reencontrá-las ao entrar de outro dispositivo. Só o próprio dono lê.
    match /gmTables/{uid}/tables/{tableId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow delete: if (signedIn() && request.auth.uid == uid) || isSuperAdmin();
    }

    match /tables/{tableId} {
      allow get: if signedIn();
      // Ninguém varre a lista de mesas: o código da mesa é o segredo. A única
      // exceção é o super administrador, que precisa ver o sistema inteiro.
      allow list: if isSuperAdmin();
      allow create: if signedIn() &&
        request.resource.data.gmUid == request.auth.uid &&
        request.resource.data.id == tableId &&
        request.resource.data.code == tableId;
      // Nem o Mestre nem o administrador podem trocar o dono da mesa.
      allow update: if (isGM(tableId) || isSuperAdmin()) &&
        request.resource.data.gmUid == resource.data.gmUid;
      allow delete: if isSuperAdmin();

      match /characters/{characterId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.tableId == tableId;
        // Edição normal: o dono da ficha ou o Mestre.
        // Reivindicação: qualquer pessoa da mesa pode assumir o controle da
        // ficha em outro dispositivo, mas a escrita só pode mexer no ownerUid.
        allow update: if signedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          isGM(tableId) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'updatedAt'])
        );
        allow delete: if isGM(tableId) || resource.data.ownerUid == request.auth.uid || isSuperAdmin();
      }

      match /npcs/{npcId} {
        allow read: if signedIn();
        allow write: if isGM(tableId);
        allow delete: if isGM(tableId) || isSuperAdmin();
      }

      match /log/{logId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update: if isGM(tableId);
        allow delete: if isGM(tableId) || isSuperAdmin();
      }

      // Rolagens secretas do Mestre: ninguém mais lê nem escreve. O super
      // administrador também lê — sem isso não conseguiria varrer a subcoleção
      // para apagar a mesa inteira.
      match /secretRolls/{rollId} {
        allow read, write: if isGM(tableId);
        allow read, delete: if isSuperAdmin();
      }

      // Pedidos de rolagem: o jogador cria o seu; o Mestre libera ou nega.
      match /rollRequests/{requestId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid;
        allow update: if isGM(tableId) || resource.data.requesterUid == request.auth.uid;
        allow delete: if isGM(tableId) || isSuperAdmin();
      }

      // Tela de jogo: todos leem (a tela de espera é decidida no cliente pelo
      // campo `revealed` — negar a leitura no Firestore mataria o listener em
      // tempo real do jogador, que não se reconecta sozinho quando o Mestre
      // revela depois). Só o Mestre escreve...
      //
      // ...com uma exceção: quando o Mestre liga `playersMoveTokens` na mesa,
      // os jogadores passam a mover a peça do próprio personagem. A regra não
      // consegue olhar peça a peça dentro do array, então ela limita o estrago
      // ao que interessa — a escrita só pode tocar em `tokens`/`updatedAt`, e
      // nada de mapa, névoa, luz ou revelação da cena. Quem decide se isso vale
      // é o Mestre, e o interruptor é dele; o cliente ainda só deixa arrastar a
      // peça do próprio personagem.
      match /scene/{sceneId} {
        allow read: if signedIn();
        allow write: if isGM(tableId);
        allow update: if signedIn() &&
          tableData(tableId).playersMoveTokens == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'updatedAt']);
        allow delete: if isGM(tableId) || isSuperAdmin();
      }

      // Marcações rápidas no mapa ("olhem aqui"): qualquer um da mesa cria,
      // todos veem, e elas somem sozinhas na tela depois de alguns segundos.
      // A faxina dos documentos velhos é feita pelo cliente do Mestre.
      match /pings/{pingId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow delete: if isGM(tableId) || isSuperAdmin();
      }

      // Biblioteca de mapas e tokens salvos pelo Mestre: só ele usa.
      match /sceneLibrary/{itemId} {
        allow read, write: if isGM(tableId);
        allow read, delete: if isSuperAdmin();
      }

      // Memória de imagens por nome de criatura (bestiário/personalizada): só
      // o Mestre usa, para lembrar a foto da última vez que editou aquele nome.
      match /monsterImages/{nameLower} {
        allow read, write: if isGM(tableId);
        allow read, delete: if isSuperAdmin();
      }
    }
  }
}
