# Modelo das variáveis de ambiente. Copie este arquivo para ".env" e preencha
# com as chaves do SEU projeto Firebase (Configurações do Projeto > Geral >
# Seus apps > SDK). Veja o README.md para o passo a passo completo.
#
# O arquivo ".env" é ignorado pelo git de propósito — só este modelo é versionado.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
